---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;
---

<Layout title="Bookshelf | zunayed.dev" bodyId="bookshelf">
  <div class="container">
    <h2>Bookshelf</h2>
    <p>A collection of books I've read or am reading.</p>
    <ul>
        <li>Start with Why - Simon Sinek</li>
        <li>Clean Code - Robert C. Martin</li>
    </ul>
  </div>
  <Footer />
</Layout>
