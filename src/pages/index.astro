---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// Import images
import graphImg from '../assets/home/graph.png';
import gridImg from '../assets/home/grid.png';
import heapImg from '../assets/home/heap.png';
import drawingImg from '../assets/home/drawing.png';

export const prerender = true;

const allPosts = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

// Helper to filter and sort
const getSeriesPosts = (seriesName: string) => {
    return allPosts
        .filter(p => p.data.series === seriesName)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
};

const blogPosts = getSeriesPosts('blog');

const seriesSections = [
    { id: 'graphs', title: 'Graphs' },
    { id: 'trees', title: 'Trees' },
    { id: 'recursion', title: 'Recursion' },
    { id: 'sorting', title: 'Sorting' },
    { id: 'heaps', title: 'Heaps' },
    { id: 'searching', title: 'Searching' },
];
---

<Layout title="zunayed.dev" bodyId="index">
  <div class="index-container">
    <div class="index-flex-item">
      <div class="aboutme" style="padding-inline: 0.5rem;">
        <p style="margin-top: 0;"> My name is <b class="header-name">Zunayed Ali</b> and I’m an engineer that grew up in Brooklyn. This is my corner on the internet to store thoughts on hobbies & interest I've accumlated over the years</p>
      </div>
    </div>

    <div class="index-flex-item">
        <div style="padding-inline: 0.5rem;">
          <Image 
              src={drawingImg} 
              alt="A drawing" 
              width={400} 
              quality="max"
              densities={[1.5, 2]}
              style="border-radius: 2px; width: 100%; height: auto;"
              loading="eager"
          />
        </div>

    </div>

    <div class="index-flex-item">
      <ul class="post-list">
        <hr/>
        <h3>Recent Posts</h3>

      </ul>
    </div>

    <div class="index-flex-item">
      <ul class="post-list">
        <hr/>
        <h3></h3>

        {blogPosts.map(post => (
        <li> 
          » <a href={`/${post.slug}`}>{post.data.title}</a>
        </li>
        ))}
      </ul>
    </div>

    <div class="index-flex-item">
      <ul class="post-list">
        <hr/>
        <h3>Projects</h3>
        <p> Below you will find some visualized solutions to random problems and algos</p>
      </ul>
    </div>

    <div class="index-flex-item">
        <ul class="post-list">
            <hr/>
            <li>
              <span class="project-title"><span class="project-bullet">»</span><a href="/activity">Activity</a></span>
              <p class="project-desc">A running log of experiments, side projects, and small wins. I update it when something ships or changes.</p>
            </li>
            <li>
              <span class="project-title"><span class="project-bullet">»</span><a href="#">YouTube Looper</a></span>
              <p class="project-desc">A tiny tool for repeating clips while practicing or studying. It keeps the focus on a single moment.</p>
            </li>
            <li>
              <span class="project-title"><span class="project-bullet">»</span><a href="https://marketplace.stripe.com/apps/bulk-actions">Stripe Bulk Invoice Downloader</a></span>
              <p class="project-desc">An app that exports invoices in bulk with a few clicks. Useful for monthly bookkeeping and client archives.</p>
            </li>
            <li>
              <span class="project-title"><span class="project-bullet">»</span><a href="/bookshelf">Bookshelf</a></span>
              <p class="project-desc">Notes and highlights from books I am reading or have finished. It is a living catalog of ideas.</p>
            </li>
        </ul>
    </div>


    <div class="index-flex-item">
      <ul class="post-list">
        <hr/>
        <h3>Data Structures, Algorithms & Puzzles</h3>
        <p> Below you will find some visualized solutions to random problems and algos</p>
        <div style="display: flex; gap: 1rem; justify-content: space-between; max-width: 90%;">
            <Image 
                src={graphImg} 
                alt="Graph algorithm visualization" 
                width={200} 
                quality="max"
                densities={[1.5, 2]}
                style="width: 28%; height: auto;" 
            />
            <Image 
                src={gridImg} 
                alt="Grid algorithm visualization" 
                width={200} 
                quality="max"
                densities={[1.5, 2]}
                style="width: 28%; height: auto;" 
            />
            <Image 
                src={heapImg} 
                alt="Heap algorithm visualization" 
                width={200} 
                quality="max"
                densities={[1.5, 2]}
                style="width: 28%; height: auto;" 
            />
        </div>
      </ul>
    </div>

    {seriesSections.map(series => {
        const posts = getSeriesPosts(series.id);
        if (posts.length === 0) return null;
        
        return (
            <div class="index-flex-item">
                <ul class="post-list">
                    <hr/>
                    <h3>{series.title}</h3>
                    {posts.map(post => (
                    <li> 
                        » <a href={`/${post.slug}`}>{post.data.title}</a>
                    </li>
                    ))}
                </ul>
            </div>
        );
    })}

  </div>
  <Footer />
</Layout>
